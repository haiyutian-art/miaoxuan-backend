# 复制本文件为 .env，并填入真实配置。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# MySQL
DB_URL=jdbc:mysql://localhost:3306/online_student_choose_system?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&connectTimeout=60000&socketTimeout=60000
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 邮箱
MAIL_HOST=smtp.qq.com
MAIL_USERNAME=your_mail@qq.com
MAIL_PASSWORD=your_smtp_auth_code

# Druid 监控页
DRUID_USERNAME=admin
DRUID_PASSWORD=your_druid_password

# ZooKeeper
ZOOKEEPER_ADDRESS=localhost:2181
